# Fail the install when Node is too old, instead of installing anyway and
# leaving a transitive dependency to throw at runtime.
#
# npm treats an `engines` mismatch as a warning by default. jsdom 30 needs
# Node 22+, CI was pinned to Node 20, and the install "succeeded" — so the
# first sign of trouble was an undici stack trace inside the validator, with
# the reason discarded by a `2>/dev/null`. A loud failure here is worth more
# than a quiet one there.
engine-strict=true
